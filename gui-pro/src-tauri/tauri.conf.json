{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "TrustTunnel Client Pro",
  "version": "3.0.0",
  "identifier": "com.trusttunnel.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TrustTunnel Client for Windows Pro v3.0.0",
        "width": 900,
        "height": 1000,
        "minWidth": 800,
        "minHeight": 1000,
        "maxWidth": 1000,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "backgroundColor": "#0d0d0d",
        "dragDropEnabled": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "trusttunnel_client"
    ],
    "resources": [
      "wintun.dll"
    ],
    "windows": {
      "allowDowngrades": true,
      "signCommand": "node ../../scripts/sign-windows-artifact.cjs %1",
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/installer-hooks.nsh",
        "headerImage": "assets/installer/header-150x57.bmp",
        "sidebarImage": "assets/installer/sidebar-164x314.bmp",
        "installerIcon": "assets/installer/installer.ico",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Russian": "nsis/Russian.nsh",
          "English": "nsis/English.nsh"
        }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^((https?://\\w+)|([A-Za-z]:[\\\\/])).+"
    }
  }
}
